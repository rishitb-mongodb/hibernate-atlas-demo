#!/usr/bin/env bash
# Reveal or re-hide the demo code for one act.
#
#   ./reveal 2        uncomment every //~ line inside the //@ACT2-START .. //@ACT2-END blocks
#   ./reveal 3
#   ./reveal reset    re-hide acts 2 and 3
#
# Useful live: if editing by hand goes wrong, this puts the file back into a known state.
set -euo pipefail
cd "$(dirname "$0")"

apply() { # $1 = act, $2 = show|hide
  local act="$1" mode="$2"
  while IFS= read -r -d '' file; do
    awk -v act="$act" -v mode="$mode" '
      $0 ~ "//@ACT" act "-START" { inside = 1; print; next }
      $0 ~ "//@ACT" act "-END"   { inside = 0; print; next }
      inside && mode == "show" { sub(/\/\/~ ?/, ""); print; next }
      inside && mode == "hide" {
        if ($0 ~ /^[[:space:]]*$/)          { print $0 "//~" }
        else if ($0 ~ /^[[:space:]]*\/\/~/) { print }
        else                                { sub(/^([[:space:]]*)/, "&//~ "); print }
        next
      }
      { print }
    ' "$file" > "$file.tmp" && mv "$file.tmp" "$file"
  done < <(find src/main/java -name '*.java' -print0)
}

case "${1:-}" in
  2|3)   apply "$1" show; echo "Act $1 revealed."                 ;;
  reset) apply 2 hide; apply 3 hide; echo "Acts 2 and 3 re-hidden." ;;
  *)     echo "usage: ./reveal {2|3|reset}" >&2; exit 2            ;;
esac
