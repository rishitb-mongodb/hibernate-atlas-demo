#!/usr/bin/env bash
# Reveal or re-hide the schema-flexibility block in Movie.java / Act2.java.
#
#   ./reveal show     uncomment every //~ line inside //@REVEAL-START .. //@REVEAL-END
#   ./reveal hide      put it back
#
# Useful live: if hand-editing goes wrong, this restores a known-good state.
set -euo pipefail
cd "$(dirname "$0")"

apply() { # $1 = show|hide
  local mode="$1"
  while IFS= read -r -d '' file; do
    awk -v mode="$mode" '
      /\/\/@REVEAL-START/ { inside = 1; print; next }
      /\/\/@REVEAL-END/   { inside = 0; print; next }
      inside && mode == "show" { sub(/\/\/~ ?/, ""); print; next }
      inside && mode == "hide" {
        if ($0 ~ /^[[:space:]]*$/)          { print $0 "//~" }
        else if ($0 ~ /^[[:space:]]*\/\/~/) { print }
        else                                { sub(/^([[:space:]]*)/, "&//~ "); print }
        next
      }
      { print }
    ' "$file" > "$file.tmp" && mv "$file.tmp" "$file"
  done < <(find src/main/java -name '*.java' -print0)
}

case "${1:-}" in
  show) apply show; echo "Revealed." ;;
  hide) apply hide; echo "Hidden."   ;;
  *)    echo "usage: ./reveal {show|hide}" >&2; exit 2 ;;
esac
