<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!--
      %mql (PrettyMqlConverter) indents the MQL Hibernate logs, instead of one long compacted
      line. Our own commentary is prefixed with >>>, # or -, so an unprefixed, indented JSON
      block is always a generated MongoDB command.
    -->
    <conversionRule conversionWord="mql" class="com.mongodb.demo.PrettyMqlConverter" />

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%mql%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- This is the line that matters: hibernate.show_sql routes through this logger. -->
    <logger name="org.hibernate.SQL" level="DEBUG"/>

    <!-- Everything else stays quiet. -->
    <logger name="org.hibernate" level="WARN"/>
    <logger name="org.mongodb.driver" level="WARN"/>

    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
